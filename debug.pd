#N canvas 100 50 950 700 10;
#X text 30 10 DJ Patch - Mrmr OSC Controller (DEBUG);
#X text 30 30 IMPORTANTE: Mira la consola de PD para ver mensajes;
#X obj 40 70 netreceive -u -b 8000;
#X obj 40 100 oscparse;
#X obj 40 130 list trim;
#X msg 40 160 Mensaje recibido: \$1;
#X obj 40 190 print MENSAJE_COMPLETO;
#X obj 40 230 route /mrmr/slider /mrmr/pushbutton /mrmr/tactilezone;
#X obj 40 270 print SLIDER_RAW;
#X obj 200 270 print BUTTON_RAW;
#X obj 360 270 print PAD_RAW;
#X obj 40 310 route /1/value /2/value;
#X obj 40 350 print SLIDER1_VALUE;
#X obj 150 350 print SLIDER2_VALUE;
#X obj 40 390 / 1023;
#X obj 40 420 * 800;
#X obj 40 450 + 200;
#X obj 40 480 s freq;
#X obj 150 390 / 1023;
#X obj 150 420 s vol;
#X obj 200 310 route /1/value;
#X obj 200 350 print BUTTON_VALUE;
#X obj 200 390 sel 1;
#X msg 200 420 open sample.wav \, start;
#X obj 200 450 readsf~ 2;
#X obj 200 480 dac~ 1 2;
#X obj 360 310 route /1/x /1/y;
#X obj 360 350 print PAD_X;
#X obj 470 350 print PAD_Y;
#X obj 360 390 / 1023;
#X obj 360 420 s pan;
#X obj 470 390 / 1023;
#X obj 470 420 * 8000;
#X obj 470 450 + 200;
#X obj 470 480 s cutoff;
#X obj 600 70 r freq;
#X obj 600 100 print FREQ_FINAL;
#X obj 600 140 r vol;
#X obj 600 170 print VOL_FINAL;
#X obj 600 210 r pan;
#X obj 600 240 print PAN_FINAL;
#X obj 600 280 r cutoff;
#X obj 600 310 print CUTOFF_FINAL;
#X obj 40 540 r freq;
#X obj 40 570 osc~;
#X obj 40 630 *~;
#X obj 90 600 r vol;
#X obj 40 690 *~;
#X obj 150 690 *~;
#X obj 40 720 dac~ 1;
#X obj 150 720 dac~ 2;
#X obj 40 600 r cutoff;
#X obj 40 660 lop~ 5000;
#X obj 40 650 r pan;
#X obj 40 670 expr 1 - $f1;
#X obj 150 650 r pan;
