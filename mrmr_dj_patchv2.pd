#X obj 40 80 netreceive -u -b 8000;
#X obj 40 110 oscparse;
#X obj 40 140 list trim;
#X obj 40 170 route mrmr;
#X obj 40 200 route slider pushbutton;
#X obj 200 200 unpack s f s f;
#X obj 200 230 route 0 1;
#X obj 200 260 / 1023;
#X obj 200 290 * 800;
#X obj 200 320 + 200;
#X obj 200 350 s freq;
#X obj 300 260 / 1023;
#X obj 300 290 s vol;

#----- OSCILLATOR -----
#X obj 200 390 r freq;
#X obj 200 420 osc~;
#X obj 200 450 *~;
#X obj 300 450 r vol;
#X obj 200 480 dac~;

#----- BOTÓN SAMPLE -----
#X obj 450 200 unpack f s f;
#X obj 450 230 route 2;
#X obj 450 260 sel 1000;
#X msg 450 290 open sample.wav, start;
#X obj 450 320 readsf~ 2;
#X connect 450 260 450 290;
#X connect 450 290 450 320;
#X connect 450 320 200 480;

